# Backend environment variables. Every value in application.yml is an
# ${ENV:default} placeholder; this file lists the ones you usually set. See
# application.yml for the full list and defaults. Never commit real secrets.

# ---- Core -------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/ebookwriter
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=change-me-at-least-32-characters-long
FRONTEND_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
POSTMARK_SERVER_TOKEN=
MAIL_FROM=no-reply@localhost

# ---- Stripe: Scrivetta PRO subscription + credit packs (platform account) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUBSCRIPTION_PRICE_ID=price_...

# ---- Stripe Connect: creator store payments (docs/stripe-connect.md) --------
# The platform's TEST secret key, used only for Connect calls (account creation,
# onboarding links, Checkout Sessions on the author's account).
STRIPE_CONNECT_SECRET_KEY=sk_test_...
# Signing secret of the separate Connect webhook endpoint
# (/api/stripe/connect/webhook) — or the one printed by
# `stripe listen --forward-connect-to ...` locally.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Live mode guard: a live key (sk_live_/rk_live_) is refused and live events are
# ignored unless this is explicitly true. Leave false until production go-live.
STRIPE_CONNECT_LIVE_ENABLED=false
# How long a buyer's Checkout Session stays open (31–1440 minutes).
STRIPE_CONNECT_CHECKOUT_EXPIRY_MINUTES=60
